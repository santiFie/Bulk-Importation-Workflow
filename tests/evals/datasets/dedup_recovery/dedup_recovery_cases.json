      "columns": ["id", "title", "author", "date", "type"],
      "sample_rows": [
        {
          "id": "101",
          "title": "Distributed Systems in Cloud Environments",
          "author": "Smith, John",
          "date": "1999, June",
          "type": "Articulo"
        },
        {
          "id": "102",
          "title": "Parallel Computing Architectures",
          "author": "Doe, Jane",
          "date": "2020-05",
          "type": "Articulo"
        }
      ],
      "memory_mode": "none",
      "episodes": []
    },
    "reference_outputs": {
      "expected_strategies": ["date_normalization", "value_mapping"],
      "expected_target_column": "date",
      "expected_confidence": ["high"],
      "expected_ambiguous": false,
      "expected_auto_repairable": true,
      "expected_hitl": false,
      "expected_cleaned_values": {
        "101": ["1999-06", "1999, 06"]
      }
    },
    "tags": ["zero_shot", "date", "english_month", "autonomous_resolution"]
  },
