  {
    "id_caso": "case_03_cbr_positive_transfer_value_mapping",
    "descripcion": "Transferencia positiva desde Memoria Episódica: mapear edición estacional ('2021, Autumn') adoptando la estrategia 'value_mapping' prescrita por el episodio previo.",
    "inputs": {
      "source_name": "scielo_ar",
      "error_msg": "ValueError: Error al comparar fechas: 2021, Autumn — invalid literal for int() with base 10: 'Autumn'",
      "columns": ["id", "title", "author", "date", "type"],
      "sample_rows": [
        {
          "id": "301",
          "title": "Biodiversidad Pampeana",
          "author": "Fernández, Lucía",
          "date": "2021, Autumn",
          "type": "Articulo"
        },
        {
          "id": "302",
          "title": "Ecología Agrícola",
          "author": "Sosa, Martín",
          "date": "2020-11",
          "type": "Articulo"
        }
      ],
      "memory_mode": "relevant",
      "episodes": [
        {
          "id": "ep_seasonal_date_mapping",
          "similarity_score": 0.94,
          "metadata": {
            "tool": "deduplicator",
            "source_name": "scielo_ar",
            "error_class": "ValueError",
            "affected_column": "date",
            "resolved_by": "autonomous"
          },
          "embedding_content": "Error al comparar fechas: 2019, Autumn — invalid literal for int() with base 10: 'Autumn'",
          "payload": {
            "error_summary": "Columna date con estación del año en inglés ('Autumn') que requiere mapeo directo de valor.",
            "culprit_sample": "2019, Autumn",
            "transformation_strategy": "value_mapping",
            "solution_applied": {
              "Autumn": "09",
              "2021, Autumn": "2021-09"
            },
            "reasoning": "Para publicaciones estacionales con 'Autumn', se utiliza obligatoriamente la estrategia 'value_mapping' reemplazando 'Autumn' por '09'."
          }
        }
      ]
    },
    "reference_outputs": {
      "expected_strategies": ["value_mapping"],
      "expected_target_column": "date",
      "expected_confidence": ["high"],
      "expected_ambiguous": false,
      "expected_auto_repairable": true,
      "expected_hitl": false,
      "expected_mapping_keys": ["Autumn", "2021, Autumn"],
      "expected_mapping_target_substrings": ["09"],
      "expected_cleaned_values": {
        "301": ["2021-09", "2021, 09"]
      }
    },
    "tags": ["cbr_positive_transfer", "value_mapping", "date", "autonomous_resolution"]
  },
  {
    "id_caso": "case_04_cbr_positive_transfer_regex",
    "descripcion": "Transferencia positiva desde Memoria Episódica: extraer el año de 4 dígitos mediante 'regex_extraction' ante celdas de fecha contaminadas con volumen ('Vol. 14 (2018)').",
    "inputs": {
      "source_name": "scopus",
      "error_msg": "ValueError: Error al comparar fechas: Vol. 14 (2018) — invalid literal for int() with base 10: 'Vol. 14 (2018)'",
      "columns": ["id", "title", "author", "date", "type"],
      "sample_rows": [
        {
          "id": "401",
          "title": "Machine Learning in Clinical Diagnostics",
          "author": "Lee, K.",
          "date": "Vol. 14 (2018)",
          "type": "Articulo"
        },
        {
          "id": "402",
          "title": "Deep Neural Networks for Imaging",
          "author": "Kim, S.",
          "date": "Vol. 15 (2019)",
          "type": "Articulo"
        }
      ],
      "memory_mode": "relevant",
      "episodes": [
        {
          "id": "ep_volume_year_regex",
          "similarity_score": 0.95,
          "metadata": {
            "tool": "deduplicator",
            "source_name": "scopus",
            "error_class": "ValueError",
            "affected_column": "date",
            "resolved_by": "autonomous"
          },
          "embedding_content": "Error al comparar fechas: Vol. 10 (2016) — invalid literal for int() with base 10: 'Vol. 10 (2016)'",
          "payload": {
            "error_summary": "Columna date contaminada con número de volumen y año entre paréntesis.",
            "culprit_sample": "Vol. 10 (2016)",
            "transformation_strategy": "regex_extraction",
            "solution_applied": {
              "pattern": "\\b(19\\d\\d|20\\d\\d)\\b",
              "group": 1
            },
            "reasoning": "Se emplea la estrategia 'regex_extraction' con el patrón '\\b(19\\d\\d|20\\d\\d)\\b' y grupo 1 para extraer únicamente el año de 4 dígitos."
          }
        }
      ]
    },
    "reference_outputs": {
      "expected_strategies": ["regex_extraction"],
      "expected_target_column": "date",
      "expected_confidence": ["high"],
      "expected_ambiguous": false,
      "expected_auto_repairable": true,
      "expected_hitl": false,
      "expected_regex_samples": {
        "Vol. 14 (2018)": "2018",
        "Vol. 15 (2019)": "2019"
      },
      "expected_cleaned_values": {
        "401": ["2018"],
        "402": ["2019"]
      }
    },
    "tags": ["cbr_positive_transfer", "regex_extraction", "date", "autonomous_resolution"]
  },
