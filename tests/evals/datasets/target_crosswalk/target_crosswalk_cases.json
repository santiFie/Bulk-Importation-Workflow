  {
    "id_caso": "case_repair_01_missing_column_renamed",
    "descripcion": "Autorreparación: El usuario proveyó un mapeo con 'Authors' que no existe en el CSV reconciliado (donde se llama 'Author_Names'). El LLM real debe identificar 'Author_Names' a partir de las muestras y preservar los mapeos válidos.",
    "inputs": {
      "source_name": "repair_rename",
      "columns": [
        "Title",
        "Author_Names",
        "Publication_Date",
        "DOI_Identifier"
      ],
      "sample_rows": [
        {
          "Title": "Neuroplasticity after ischemic stroke in adults",
          "Author_Names": "Fernandez, Lucia || Rossi, Daniel",
          "Publication_Date": "2024",
          "DOI_Identifier": "10.1016/j.neulet.2024.137890"
        },
        {
          "Title": "Cognitive rehabilitation protocols in elderly patients",
          "Author_Names": "Lopez, Mariano || Castro, Sofia",
          "Publication_Date": "2025",
          "DOI_Identifier": "10.1016/j.neulet.2025.138000"
        }
      ],
      "user_target_config": [
        [
          {
            "left": "Title",
            "replace": "dc.title[es]",
            "required": true
          },
          {
            "left": "Authors",
            "replace": "sedici.creator.person[es]",
            "required": false
          },
          {
            "left": "Publication_Date",
            "replace": "dc.date.issued",
            "required": false
          },
          {
            "left": "DOI_Identifier",
            "replace": "sedici.identifier.doi",
            "required": false
          }
        ],
        {
          "replace_separator": "||",
          "file_delimiter": ","
        }
      ]
    },
    "reference_outputs": {
      "expected_mappings": {
        "Title": "dc.title[es]",
        "Author_Names": "sedici.creator.person[es]",
        "Publication_Date": "dc.date.issued",
        "DOI_Identifier": "sedici.identifier.doi"
      },
      "forbidden_mappings": {
        "Authors": "sedici.creator.person[es]"
      },
      "repaired_columns": [
        "Author_Names"
      ],
      "preserved_columns": [
        "Title",
        "Publication_Date",
        "DOI_Identifier"
      ],
      "critical_fields": [
        "dc.title[es]",
        "sedici.creator.person[es]",
        "dc.date.issued",
        "sedici.identifier.doi"
      ],
      "expected_tools": [
        "save_column_mappings"
      ]
    },
    "tags": [
      "repair",
      "user_config",
      "column_rename",
      "llm_repair"
    ]
  },
