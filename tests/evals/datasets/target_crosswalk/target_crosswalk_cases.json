[
  {
    "id_caso": "case_format_01_pure_generic",
    "descripcion": "CSV reconciliado normalizado proveniente de ingesta de PDFs (MinIO). Las columnas canónicas son cubiertas en Nivel 1 y la columna 'id' (nombre de archivo PDF) es mapeada a 'files' por el LLM.",
    "inputs": {
      "source_name": "pdf_minio",
      "columns": [
        "id",
        "title",
        "author",
        "date",
        "type",
        "doi",
        "issn",
        "citation"
      ],
      "sample_rows": [
        {
          "id": "39-jaiio-ast-04.pdf-PDFA.pdf",
          "title": "La Transformada Discreta de Karhunen Loève es la base de un método de compresión de imágenes",
          "author": "Delrieux, Claudio || Silvetti, Andrea",
          "date": "2010",
          "type": "articulo",
          "doi": "",
          "issn": "1850-2806",
          "citation": "39 JAIIO - AST 2010 - ISSN: 1850-2806"
        },
        {
          "id": "39-jaiio-ast-06.pdf-PDFA.pdf",
          "title": "Estimacion de texturas",
          "author": "Gonzalez, Maria || Perez, Juan",
          "date": "2010",
          "type": "objeto de conferencia",
          "doi": "",
          "issn": "1850-2806",
          "citation": "39 JAIIO - AST 2010"
        }
      ],
      "source_crosswalk_config": null,
      "user_target_config": null
    },
    "reference_outputs": {
      "expected_mappings": {
        "title": "dc.title[es]",
        "author": "sedici.creator.person[es]",
        "date": "dc.date.issued",
        "type": "dc.type",
        "issn": "sedici.identifier.issn",
        "citation": "sedici.relation.journalTitle[es]",
        "id": "files"
      },
      "forbidden_mappings": {},
      "critical_fields": [
        "dc.title[es]",
        "sedici.creator.person[es]",
        "dc.date.issued"
      ],
      "expected_tools": [
        "save_column_mappings"
      ],
      "forbidden_tools": []
    },
    "tags": [
      "format",
      "generic",
      "deterministic_level1"
    ]
  },
  {
    "id_caso": "case_format_02_heterogeneous_pubmed",
    "descripcion": "CSV reconciliado de PubMed con columnas remanentes (PMID, PMCID, NIHMS ID, inferred_type). El LLM mapea identificadores a sedici.identifier.other, subtype a sedici.subtype[es], y se abstiene de First Author y Create Date.",
    "inputs": {
      "source_name": "pubmed",
      "columns": [
        "PMID",
        "Title",
        "Authors",
        "First Author",
        "Journal/Book",
        "Publication Year",
        "Create Date",
        "PMCID",
        "NIHMS ID",
        "DOI",
        "inferred_type"
      ],
      "sample_rows": [
        {
          "PMID": "41118147",
          "Title": "Kinases go where the function calls",
          "Authors": "Said M, Mattiazzi A, Mundiña-Weilenmann C.",
          "First Author": "Said M",
          "Journal/Book": "Cardiovasc Res",
          "Publication Year": "2025",
          "Create Date": "2025/10/21",
          "PMCID": "",
          "NIHMS ID": "",
          "DOI": "10.1093/cvr/cvaf197",
          "inferred_type": "journal-article"
        },
        {
          "PMID": "40966355",
          "Title": "1206 genomes reveal origin and movement of Aedes aegypti driving increased dengue risk",
          "Authors": "Crawford JE, Balcazar D, Redmond S",
          "First Author": "Crawford JE",
          "Journal/Book": "Science",
          "Publication Year": "2025",
          "Create Date": "2025/09/18",
          "PMCID": "PMC12952217",
          "NIHMS ID": "NIHMS2144453",
          "DOI": "10.1126/science.ads3732",
          "inferred_type": "journal-article"
        }
      ],
      "source_crosswalk_config": [
        [
          {
            "left": "Title",
            "replace": "title",
            "required": true
          },
          {
            "left": "Authors",
            "replace": "author",
            "required": false
          },
          {
            "left": "Publication Year",
            "replace": "date",
            "required": false
          },
          {
            "left": "Journal/Book",
            "replace": "citation",
            "required": false
          },
          {
            "left": "DOI",
            "replace": "doi",
            "required": false
          }
        ],
        {
          "replace_separator": "||",
          "file_delimiter": ","
        }
      ],
      "user_target_config": null
    },
    "reference_outputs": {
      "expected_mappings": {
        "Title": "dc.title[es]",
        "Authors": "sedici.creator.person[es]",
        "Publication Year": "dc.date.issued",
        "Journal/Book": "sedici.relation.journalTitle[es]",
        "DOI": "sedici.identifier.doi",
        "PMID": "sedici.identifier.other",
        "inferred_type": "sedici.subtype[es]"
      },
      "forbidden_mappings": {
        "First Author": "sedici.creator.person[es]"
      },
      "critical_fields": [
        "dc.title[es]",
        "sedici.creator.person[es]",
        "dc.date.issued",
        "sedici.identifier.doi"
      ],
      "expected_tools": [
        "save_column_mappings"
      ],
      "forbidden_tools": []
    },
    "tags": [
      "format",
      "heterogeneous",
      "remnants",
      "llm_level2"
    ]
  },
